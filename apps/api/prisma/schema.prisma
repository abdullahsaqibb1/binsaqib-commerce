generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  OWNER
  ADMIN
  STAFF
  SUPPORT
  FULFILLMENT
  FINANCE
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductOptionDisplay {
  SWATCH
  BUTTONS
  DROPDOWN
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RELEASE
  DAMAGE
  TRANSFER
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  VOIDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED
  RETURNED
}

enum OrderSource {
  STOREFRONT
  MANUAL
  EXTERNAL
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  PHONE
  OTHER
}

enum PaymentMethodType {
  CASH_ON_DELIVERY
  BANK_TRANSFER
  CARD
  WALLET
  CASH
  OTHER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewSource {
  CUSTOMER
  INTERNAL
  EXTERNAL
}

enum DiscountType {
  FIXED_AMOUNT
  PERCENTAGE
  FREE_SHIPPING
}

enum ExpenseCategory {
  INVENTORY
  SHIPPING
  ADVERTISING
  PACKAGING
  SALARY
  SOFTWARE
  UTILITIES
  REFUND
  OTHER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model StaffUser {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String
  passwordHash       String
  role               StaffRole            @default(STAFF)
  status             AccountStatus        @default(ACTIVE)
  lastLoginAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sessions           AdminSession[]
  ordersCreated      Order[]              @relation("OrderCreator")
  statusChanges      OrderStatusHistory[] @relation("OrderStatusChangedBy")
  inventoryMovements InventoryMovement[]  @relation("InventoryMovementActor")
  expensesCreated    Expense[]            @relation("ExpenseCreator")
  reviewsModerated   Review[]             @relation("ReviewModerator")
  auditLogs          AuditLog[]           @relation("AuditActor")

  @@index([status, role])
}

model AdminSession {
  id          String    @id @default(cuid())
  staffUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  ipHash      String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId, expiresAt])
}

model Customer {
  id               String            @id @default(cuid())
  email            String?           @unique
  phone            String?           @unique
  firstName        String?
  lastName         String?
  passwordHash     String?
  status           AccountStatus     @default(ACTIVE)
  acceptsMarketing Boolean           @default(false)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  lastOrderAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         CustomerSession[]
  addresses        CustomerAddress[]
  orders           Order[]
  reviews          Review[]

  @@index([status, createdAt])
  @@index([lastOrderAt])
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String
  label         String?
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  province      String?
  postalCode    String?
  countryCode   String   @default("PK")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
  @@index([city])
}

model Category {
  id          String            @id @default(cuid())
  parentId    String?
  name        String
  slug        String            @unique
  description String?
  imageUrl    String?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]

  @@index([parentId, sortOrder])
  @@index([isActive])
}

model Collection {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  imageUrl    String?
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  products    ProductCollection[]
  discounts   CollectionDiscount[]

  @@index([isActive, sortOrder])
}

model Product {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  brand            String?
  shortDescription String?
  description      String?
  status           ProductStatus       @default(DRAFT)
  basePrice        Decimal             @default(0) @db.Decimal(12, 2)
  compareAtPrice   Decimal?            @db.Decimal(12, 2)
  featured         Boolean             @default(false)
  seoTitle         String?
  seoDescription   String?
  averageRating    Decimal             @default(0) @db.Decimal(3, 2)
  reviewCount      Int                 @default(0)
  metadata         Json?
  publishedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  variants         ProductVariant[]
  media            ProductMedia[]
  options          ProductOption[]
  addOnGroups      ProductAddOnGroup[]
  categories       ProductCategory[]
  collections      ProductCollection[]
  discounts        ProductDiscount[]
  reviews          Review[]

  @@index([status, featured])
  @@index([brand])
  @@index([publishedAt])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  mediaType String   @default("image")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id             String               @id @default(cuid())
  productId      String
  name           String
  sku            String               @unique
  barcode        String?              @unique
  price          Decimal              @db.Decimal(12, 2)
  compareAtPrice Decimal?             @db.Decimal(12, 2)
  defaultCost    Decimal              @default(0) @db.Decimal(12, 2)
  weightGrams    Int?
  imageUrl       String?
  isDefault      Boolean              @default(false)
  isActive       Boolean              @default(true)
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues   VariantOptionValue[]
  inventory      InventoryItem?
  orderItems     OrderItem[]
  linkedAddOns   AddOnOption[]        @relation("LinkedAddOnVariant")

  @@index([productId, isActive])
}

model ProductOption {
  id          String               @id @default(cuid())
  productId   String
  name        String
  displayType ProductOptionDisplay @default(BUTTONS)
  sortOrder   Int                  @default(0)
  required    Boolean              @default(true)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values      ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId, sortOrder])
}

model ProductOptionValue {
  id        String               @id @default(cuid())
  optionId  String
  value     String
  colorHex  String?
  imageUrl  String?
  sortOrder Int                  @default(0)
  option    ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants  VariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId, sortOrder])
}

model VariantOptionValue {
  variantId     String
  optionValueId String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductAddOnGroup {
  id          String        @id @default(cuid())
  productId   String
  name        String
  description String?
  required    Boolean       @default(false)
  minSelect   Int           @default(0)
  maxSelect   Int           @default(1)
  sortOrder   Int           @default(0)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  options     AddOnOption[]

  @@index([productId, sortOrder])
}

model AddOnOption {
  id                     String            @id @default(cuid())
  groupId                String
  name                   String
  value                  String?
  priceDelta             Decimal           @default(0) @db.Decimal(12, 2)
  linkedProductVariantId String?
  imageUrl               String?
  sortOrder              Int               @default(0)
  isActive               Boolean           @default(true)
  group                  ProductAddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  linkedProductVariant   ProductVariant?   @relation("LinkedAddOnVariant", fields: [linkedProductVariantId], references: [id], onDelete: SetNull)
  orderItemAddOns        OrderItemAddOn[]

  @@index([groupId, sortOrder])
  @@index([linkedProductVariantId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductCollection {
  productId    String
  collectionId String
  sortOrder    Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, sortOrder])
}

model InventoryItem {
  id               String              @id @default(cuid())
  variantId        String              @unique
  quantityOnHand   Int                 @default(0)
  quantityReserved Int                 @default(0)
  reorderPoint     Int                 @default(0)
  location         String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  variant          ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batches          InventoryBatch[]
  movements        InventoryMovement[]

  @@index([quantityOnHand])
}

model InventoryBatch {
  id                String              @id @default(cuid())
  inventoryItemId   String
  supplierName      String?
  supplierReference String?
  unitCost          Decimal             @db.Decimal(12, 2)
  quantityReceived  Int
  quantityRemaining Int
  receivedAt        DateTime            @default(now())
  notes             String?
  createdAt         DateTime            @default(now())
  inventoryItem     InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  movements         InventoryMovement[]

  @@index([inventoryItemId, receivedAt])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  inventoryItemId String
  batchId         String?
  orderItemId     String?
  actorId         String?
  type            InventoryMovementType
  quantity        Int
  unitCost        Decimal?              @db.Decimal(12, 2)
  reference       String?
  notes           String?
  createdAt       DateTime              @default(now())
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  batch           InventoryBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  orderItem       OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  actor           StaffUser?            @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([orderItemId])
  @@index([type, createdAt])
}

model Order {
  id                    String               @id @default(cuid())
  orderNumber           String               @unique
  source                OrderSource          @default(STOREFRONT)
  sourceLabel           String?
  externalReference     String?
  customerId            String?
  createdById           String?
  customerName          String
  customerEmail         String?
  customerPhone         String
  status                OrderStatus          @default(PENDING)
  paymentStatus         PaymentStatus        @default(UNPAID)
  fulfillmentStatus     FulfillmentStatus    @default(UNFULFILLED)
  currency              String               @default("PKR")
  subtotal              Decimal              @default(0) @db.Decimal(12, 2)
  discountTotal         Decimal              @default(0) @db.Decimal(12, 2)
  shippingTotal         Decimal              @default(0) @db.Decimal(12, 2)
  taxTotal              Decimal              @default(0) @db.Decimal(12, 2)
  grandTotal            Decimal              @default(0) @db.Decimal(12, 2)
  costOfGoods           Decimal              @default(0) @db.Decimal(12, 2)
  estimatedShippingCost Decimal              @default(0) @db.Decimal(12, 2)
  contributionProfit    Decimal              @default(0) @db.Decimal(12, 2)
  discountCode          String?
  customerNotes         String?
  internalNotes         String?
  shippingAddress       Json
  billingAddress        Json?
  placedAt              DateTime             @default(now())
  confirmedAt           DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  customer              Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy             StaffUser?           @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  payments              Payment[]
  statusHistory         OrderStatusHistory[]
  trackingTokens        OrderTrackingToken[]
  reviews               Review[]
  riskSignals           OrderRiskSignal[]

  @@index([status, placedAt])
  @@index([paymentStatus, placedAt])
  @@index([fulfillmentStatus, placedAt])
  @@index([source, placedAt])
  @@index([customerId])
  @@index([customerPhone])
  @@index([externalReference])
}

model OrderItem {
  id                 String              @id @default(cuid())
  orderId            String
  productVariantId   String?
  productName        String
  variantName        String?
  sku                String
  quantity           Int
  unitPrice          Decimal             @db.Decimal(12, 2)
  unitCost           Decimal             @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal             @default(0) @db.Decimal(12, 2)
  lineTotal          Decimal             @db.Decimal(12, 2)
  selectedOptions    Json?
  createdAt          DateTime            @default(now())
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant     ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  addOns             OrderItemAddOn[]
  inventoryMovements InventoryMovement[]

  @@index([orderId])
  @@index([productVariantId])
  @@index([sku])
}

model OrderItemAddOn {
  id            String       @id @default(cuid())
  orderItemId   String
  addOnOptionId String?
  name          String
  value         String?
  quantity      Int          @default(1)
  unitPrice     Decimal      @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal      @default(0) @db.Decimal(12, 2)
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addOnOption   AddOnOption? @relation(fields: [addOnOptionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  changedById String?
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdAt   DateTime     @default(now())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   StaffUser?   @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model OrderTrackingToken {
  id        String    @id @default(cuid())
  orderId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, expiresAt])
}

model OrderRiskSignal {
  id        String   @id @default(cuid())
  orderId   String
  code      String
  score     Int      @default(0)
  details   Json?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, resolved])
  @@index([code, createdAt])
}

model PaymentMethod {
  id            String            @id @default(cuid())
  name          String
  type          PaymentMethodType
  instructions  String?
  configuration Json?
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  payments      Payment[]

  @@index([isActive, sortOrder])
}

model Payment {
  id              String         @id @default(cuid())
  orderId         String
  paymentMethodId String?
  status          PaymentStatus  @default(PENDING)
  amount          Decimal        @db.Decimal(12, 2)
  externalId      String?
  provider        String?
  metadata        Json?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([externalId])
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  customerId       String?
  orderId          String?
  moderatedById    String?
  authorName       String
  authorEmail      String?
  rating           Int
  title            String?
  body             String
  source           ReviewSource @default(CUSTOMER)
  externalSource   String?
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order            Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  moderatedBy      StaffUser?   @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([customerId])
}

model Discount {
  id                String               @id @default(cuid())
  code              String               @unique
  name              String
  type              DiscountType
  value             Decimal              @db.Decimal(12, 2)
  minimumOrderValue Decimal?             @db.Decimal(12, 2)
  maximumDiscount   Decimal?             @db.Decimal(12, 2)
  usageLimit        Int?
  usageCount        Int                  @default(0)
  perCustomerLimit  Int?
  startsAt          DateTime?
  endsAt            DateTime?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  products          ProductDiscount[]
  collections       CollectionDiscount[]

  @@index([isActive, startsAt, endsAt])
}

model ProductDiscount {
  productId  String
  discountId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([productId, discountId])
  @@index([discountId])
}

model CollectionDiscount {
  collectionId String
  discountId   String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  discount     Discount   @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([collectionId, discountId])
  @@index([discountId])
}

model ShippingZone {
  id          String         @id @default(cuid())
  name        String
  countryCode String         @default("PK")
  cities      Json?
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  rates       ShippingRate[]

  @@index([isActive, sortOrder])
}

model ShippingRate {
  id               String       @id @default(cuid())
  shippingZoneId   String
  name             String
  amount           Decimal      @db.Decimal(12, 2)
  freeAbove        Decimal?     @db.Decimal(12, 2)
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  isActive         Boolean      @default(true)
  shippingZone     ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@index([shippingZoneId, isActive])
}

model Expense {
  id          String          @id @default(cuid())
  createdById String?
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("PKR")
  occurredAt  DateTime
  reference   String?
  receiptUrl  String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   StaffUser?      @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category, occurredAt])
}

model PageContent {
  id          String        @id @default(cuid())
  key         String        @unique
  title       String?
  content     Json
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model StoreSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublic])
}

model ThemeSetting {
  id         String   @id @default("default")
  palette    Json
  typography Json
  layout     Json?
  customCss  String?
  updatedAt  DateTime @updatedAt
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payloadHash String?
  processedAt DateTime?
  failedAt    DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([provider, eventType, createdAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime   @default(now())
  actor      StaffUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
