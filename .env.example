# Neon runtime connection (pooled and Prisma-optimized).
DATABASE_POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Neon migration connection (direct/non-pooling).
DATABASE_POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Generic integration fallback.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

STOREFRONT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

SESSION_SECRET="replace-with-at-least-32-random-characters"
CSRF_SECRET="replace-with-at-least-32-random-characters"
ADDRESS_ENCRYPTION_KEY="replace-with-a-32-byte-key"
