# Shared database connection. Use the pooled Neon URL for application traffic.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Use the direct Neon URL for Prisma migrations when required.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Public application URLs.
STOREFRONT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Authentication and encryption. Generate unique production values.
SESSION_SECRET="replace-with-at-least-32-random-characters"
CSRF_SECRET="replace-with-at-least-32-random-characters"
ADDRESS_ENCRYPTION_KEY="replace-with-a-32-byte-key"
